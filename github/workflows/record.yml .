name: בדיקת שיא
on:
  schedule:
    - cron: '*/10 * * * *'
  workflow_dispatch:
permissions:
  contents: write
concurrency: record-check
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - id: c
        run: python3 check.py
      - if: steps.c.outputs.send == 'true'
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: smtp.gmail.com
          server_port: 465
          secure: true
          username: ${{ secrets.MAIL_USER }}
          password: ${{ secrets.MAIL_PASS }}
          from: מונה זמן <${{ secrets.MAIL_USER }}>
          to: ${{ secrets.MAIL_USER }}
          subject: 🏆 שברת שיא!
          body: ${{ steps.c.outputs.body }}
      - if: steps.c.outputs.send == 'true'
        run: |
          git config user.name "record-bot"
          git config user.email "record-bot@users.noreply.github.com"
          git add data.json
          git commit -m "notified"
          git pull --rebase
          git push
